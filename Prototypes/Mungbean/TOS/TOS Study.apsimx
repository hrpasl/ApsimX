                {
                  "$type": "Models.Manager, Models",
                  "Code": "using APSIM.Shared.Utilities;\r\nusing Models.Utilities;\r\nusing Models.Soils;\r\nusing Models.PMF;\r\nusing Models.Core;\r\nusing System;\r\n\r\nnamespace Models\r\n{\r\n    [Serializable]\r\n    public class Script : Model\r\n    {\r\n        [Link] Clock Clock;\r\n        [Link] Fertiliser Fertiliser;\r\n        [Link] Summary Summary;\r\n        [Link] Soil Soil;\r\n        \r\n        [Description(\"Crop\")]\r\n        public IPlant Crop { get; set; }\n        \n        [Description(\"Sow on the same day(s) each year?\")]\n        public bool EachYear { get; set; }\r\n\r\n        [Description(\"First Sowing date (d-mmm)\")]\r\n        public string FirstSowDate { get; set; } \n        \n        [Description (\"Factorial Days After First Sowing Date\")]\n        public int numdays {get; set;}\n\n       private DateTime SowDate;\n       \n       private int StartYear;\n\r\n        [Display(Type = DisplayType.CultivarName)]\r\n        [Description(\"Cultivar to be sown\")]\r\n        public string CultivarName { get; set; }\r\n\r\n        [Description(\"Sowing depth (mm)\")]\r\n        public double SowingDepth { get; set; }\r\n\r\n        [Description(\"Row spacing (mm)\")]\r\n        public double RowSpacing { get; set; }\r\n\r\n        [Description(\"Plant population (/m2)\")]\r\n        public double Population { get; set; }\n\n            \n        //Sow on incremental dates\n       [EventSubscribe(\"DoManagement\")]\n        private void OnDoManagement(object sender, EventArgs e)\r\n        {\n        if (Clock.Today.Month==9)\n        \tStartYear=Clock.Today.Year;\n        \t\r\n           SowDate = DateTime.Parse(FirstSowDate + \"-\" + StartYear.ToString());\n            SowDate= SowDate.AddDays(numdays);\n            if (Clock.Today==SowDate)\n       \r\n            {\r\n                Crop.Sow(population: Population, cultivar: CultivarName, depth: SowingDepth, rowSpacing: RowSpacing);    \r\n            }\r\n        }\r\n    }\r\n}",
                  "Parameters": [
                    {
                      "Key": "Crop",
                      "Value": "[Mungbean]"
                    },
                    {
                      "Key": "EachYear",
                      "Value": "True"
                    },
                    {
                      "Key": "FirstSowDate",
                      "Value": "1-sep"
                    },
                    {
                      "Key": "numdays",
                      "Value": "0"
                    },
                    {
                      "Key": "CultivarName",
                      "Value": "Jade"
                    },
                    {
                      "Key": "SowingDepth",
                      "Value": "50"
                    },
                    {
                      "Key": "RowSpacing",
                      "Value": "500"
                    },
                    {
                      "Key": "Population",
                      "Value": "30"
                    }
                  ],
                  "Name": "SowingRule",
                  "ResourceName": null,
                  "Children": [],
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Manager, Models",
                  "Code": "using Models.Soils.Nutrients;\r\nusing APSIM.Shared.Utilities;\r\nusing Models.Surface;\r\nusing Models.Utilities;\r\nusing Models.Soils.Nutrients;\r\nusing Models.Soils;\r\nusing Models.PMF;\r\nusing Models.Core;\r\nusing System;\r\nusing Models.Interfaces;\r\n\r\nnamespace Models\r\n{\r\n    [Serializable]\r\n    public class Script : Model\r\n    {\r\n        [Link] private Plant Mungbean;\r\n        [Link] private ISoilWater SoilWater;\r\n        [Link] private Nutrient nutrient;\r\n        [Link] private SurfaceOrganicMatter SOM;\r\n        [Link] private Summary Summary;\r\n\r\n        [Description(\"Reset Water? (Yes or No)\")]\r\n        public string ResetWater {get;set;}\r\n\r\n        [Description(\"Reset Soil Nutrients? (Yes or No)\")]\r\n        public string ResetNutrients {get;set;}\r\n\r\n        [Description(\"Reset Surface Organic Matter? (Yes or No)\")]\r\n        public string ResetSOM {get;set;}\r\n\r\n        [EventSubscribe(\"Sowing\")]\r\n        private void OnSowing(object sender, EventArgs e)\r\n        {\r\n            if (ResetWater == \"Yes\")\r\n            {\r\n                Summary.WriteMessage(this, \"Reset Water\", MessageType.Diagnostic);\r\n                SoilWater.Reset();\r\n            }\r\n            if (ResetNutrients == \"Yes\")\r\n            {\r\n                Summary.WriteMessage(this, \"Reset Nutrients\", MessageType.Diagnostic);\r\n                nutrient.Reset();\r\n            }\r\n            if (ResetSOM == \"Yes\")\r\n            {\r\n                Summary.WriteMessage(this, \"Reset Surface OM\", MessageType.Diagnostic);\r\n                SOM.Reset();\r\n            }\r\n        }\r\n    }\r\n}\r\n",
                  "Parameters": [
                    {
                      "Key": "ResetWater",
                      "Value": "Yes"
                    },
                    {
                      "Key": "ResetNutrients",
                      "Value": "Yes"
                    },
                    {
                      "Key": "ResetSOM",
                      "Value": "Yes"
                    }
                  ],
                  "Name": "Reset on sowing",
                  "ResourceName": null,
                  "Children": [],
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Irrigation, Models",
                  "Name": "Irrigation",
                  "ResourceName": null,
                  "Children": [],
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Manager, Models",
                  "Code": "using Models.PMF.Phen;\nusing APSIM.Shared.Utilities;\nusing System.Xml.Serialization;\nusing Models;\nusing Models.Utilities;\nusing Models.PMF;\nusing Models.Soils;\nusing System.Text;\nusing System.Collections.Generic;\nusing Models.Core;\nusing System;\nusing Models.Climate;\n\n\nnamespace Models\n{\n    [Serializable] \n    public class Script : Model\n    {      \n        [Link] private Plant Mungbean;\n        [Link] private Zone zone;\n        [Link] Weather weather;\n        [Link] ISummary summary = null;\n        [Link(Type = LinkType.Path, Path = \"[Mungbean].Phenology\")]\n        private Phenology phenology;\n \n        public double FlotoMidGFCumRain {get; set;} = 0;\n        public double FlotoMidGFDays {get; set;}=0;\n        public double FlotoMidGFCumRad {get; set;} = 0;\n        public double FlotoMidGFCumMinT {get; set;} = 0;\n        public double FlotoMidGFCumMaxT {get; set;} = 0;\n        public double FlotoMidGFCumVPD {get; set;} = 0;\n        public double FlotoMidGFAvgRad {get; set;}\n        public double FlotoMidGFAvgMinT {get; set;}\n        public double FlotoMidGFAvgMaxT {get; set;}\n        public double FlotoMidGFAvgVPD {get; set;}\n        \n        public double FlotoLateGFCumRain {get; set;} = 0;\n        public double FlotoLateGFDays {get; set;}=0;\n        public double FlotoLateGFCumRad {get; set;} = 0;\n        public double FlotoLateGFCumMinT {get; set;} = 0;\n        public double FlotoLateGFCumMaxT {get; set;} = 0;\n        public double FlotoLateGFCumVPD {get; set;} = 0;\n        public double FlotoLateGFAvgRad {get; set;}\n        public double FlotoLateGFAvgMinT {get; set;}\n        public double FlotoLateGFAvgMaxT {get; set;}\n        public double FlotoLateGFAvgVPD {get; set;}\n        \n        \n        public double SeasonRain {get;set;} = 0;\n        public double SeasonET {get;set;} = 0;\n        public double SeasonAridity {get;set;}\n        \n        public double SummerRain {get;set;} = 0;\n        public double SummerET {get;set;} = 0;\n        public double SummerAridity {get;set;}\n        \n        public double VegMinT {get;set;}\n        public double VegMaxT {get;set;}\n\n        \n      [EventSubscribe(\"DoManagement\")] \n        private void OnDoManagement(object sender, EventArgs e)\n        {\n         double stage = (double)Mungbean.FindByPath(\"Phenology.Stage\").Value; \n \n        if (stage >=4 && stage<=7)\n        {    \n        \tFlotoMidGFDays +=1;\n        \tFlotoMidGFCumRain += weather.Rain;\n        \tFlotoMidGFCumRad += weather.Radn;\n        \tFlotoMidGFAvgRad = FlotoMidGFCumRad/FlotoMidGFDays;\n        \tFlotoMidGFCumMinT += weather.MinT;\n        \tFlotoMidGFAvgMinT = FlotoMidGFCumMinT/FlotoMidGFDays;       \n        \tFlotoMidGFCumMaxT += weather.MaxT;\n        \tFlotoMidGFAvgMaxT = FlotoMidGFCumMaxT/FlotoMidGFDays;\n        \tFlotoMidGFCumVPD += weather.VPD;\n        \tFlotoMidGFAvgVPD = FlotoMidGFCumVPD/FlotoMidGFDays;         \n    \t}\n    \n        if (stage >=4 && stage<=8)\n        {    \n        \tFlotoLateGFDays +=1;\n        \tFlotoLateGFCumRain += weather.Rain;\n        \tFlotoLateGFCumRad += weather.Radn;\n        \tFlotoLateGFAvgRad = FlotoLateGFCumRad/FlotoLateGFDays;\n        \tFlotoLateGFCumMinT += weather.MinT;\n        \tFlotoLateGFAvgMinT = FlotoLateGFCumMinT/FlotoLateGFDays;       \n        \tFlotoLateGFCumMaxT += weather.MaxT;\n        \tFlotoLateGFAvgMaxT = FlotoLateGFCumMaxT/FlotoLateGFDays;\n        \tFlotoLateGFCumVPD += weather.VPD;\n        \tFlotoLateGFAvgVPD = FlotoLateGFCumVPD/FlotoLateGFDays;\n    \t}\n\n\n\t\t\t    \n    \n}\n}\n}\n\n",
                  "Parameters": [],
                  "Name": "Calculations",
                  "ResourceName": null,
                  "Children": [],
                  "Enabled": true,
                  "ReadOnly": false
                },
