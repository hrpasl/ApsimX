                  "MinimumAmount": 0.0,
                  "UseDigestibilityFromModel": false
                },
                {
                  "$type": "Models.ForageDigestibility.ForageMaterialParameters, Models",
                  "Name": "AGPRyegrass.Leaf",
                  "IsLive": true,
                  "DigestibilityString": "0.7",
