        {
          "$type": "Models.Manager, Models",
          "Code": "using System.Diagnostics;\r\nusing Models.AgPasture;\r\nusing System.Collections.Generic;\r\nusing System.Collections;\r\nusing Models.Soils;\r\nusing Models.PMF;\r\nusing System.Xml.Serialization;\r\nusing APSIM.Shared.Utilities;\r\nusing Models.GrazPlan;\r\nusing Models.Utilities;\r\nusing Models.Core;\r\nusing System;\r\nusing System.Linq;\r\nusing Models.ForageDigestibility;\r\n\r\nnamespace Models\r\n{\r\n\r\n\r\n        //List<AgPasture.PastureSpecies> Pasture = new List<AgPasture.PastureSpecies>();\r\n\r\n        [Serializable]\n    public class Script : Model\n    {\n        [Link] Clock clock;\n        [Link] Stock stock;\n        [Link] Summary Summary;\n        [Link] IPlant plant;\n        [Link] Soil Soil;\n        [Link] Zone Paddock;\n        [Link] ScriptCompiler compiler;\n            \n        [Description(\"Promote for breeding early?\")]\n        public bool PromoteEarly { get; set; }\n      \n       [Description(\"Promotion day for breeding (dd-mmm)\")] \n       [Display(EnabledCallback = \"PromoteEarly\")]\n        public string JoinEarlyDate { get; set; }\n      \n       [Description(\"First date to consider joining animals (dd-mmm)\")] \n        public string JoinFirstDate { get; set; }\n\n        [Description(\"Last date to consider joining animals (dd-mmm)\")] \n        public string JoinLastDate { get; set; }  \n        \n        [Description(\"Number of days allowed for joining\")] \n        public int Join_Length { get; set; }  \n        \n        [Description(\"Age of lambs at weaning (days)\")] \n        public int wean_age_days { get; set; }  \n        \n        [Description(\"Terminal breed\")] \n        public string mated_to { get; set; }  \n        \n        [Description(\"Time (days) from joining of rams and first mating\")] \n        public int mating_offset { get; set; }  \n        \n        [Description(\"Number of lambs born per ewe\")] \n        public string lambing_rate { get; set; }  \n        \n        [Description(\"Number of days for gestation.\")] \n        public int gestation { get; set; }  \n        \n        [Description(\"Male stock are castrated (wether lambs).\")] \n        public bool castrate { get; set; }  \n        \n        [Description(\"How many castrated (wether lambs).\")] \n        public int num_castrate { get; set; }      \n        \n        [Description(\"How many weaned (male and female lambs).\")] \n        public int num_to_wean { get; set; }      \n        \n        private string EventName;\n        \n        private DateTime JoinDate;\n        \n        private DateTime join_median;\n        \n        private DateTime birthsday;\n        \n        private DateTime castrate_day;\n        \n        private DateTime wean_day;\n        \n  \n\r\n   // Ewe reproduction and lamb management //\n   \n   /// <summary>\n   /// Joining ewes                                \n   /// </summary>\n   \n         [EventSubscribe(\"DoManagement\")]\n        private void OnDoManagement(object sender, EventArgs e)\n        {\n            EventName = string.Empty;\n            \n            if (DateUtilities.WithinDates(JoinEarlyDate, clock.Today, JoinLastDate) || DateUtilities.WithinDates(JoinFirstDate, clock.Today, JoinLastDate))\n                {  \n                stock.Join(mated_to, Join_Length);\n                \n                JoinDate = clock.Today;\n                }\n                \n            if (DateUtilities.WithinDates(castrate_day, clock.Today, castrate_day))\n            {\n            stock.Castrate(num_castrate); //not sure if you want to do this as a % of all males?\n   \n   \t\t\tif (DateUtilities.WithinDates(wean_day, clock.Today, wean_day))\n   \t\t\t\t{\n   \t\t\t\tstock.Wean(num_to_wean,true,true); //not sure if you want to do this as a % of all lambs? the first true refers to male lambs, the second to female: do people ever want one not the other?\n   \t\t\t\t}\n   \t\t\t\t//I think this automatically regroups them. need to put in a line to move them to a new paddock. In Lucy's script, she just moves them to another paddock immediately by naming which paddock they'd move to and then lets the rotation (graze) script take over\n   \n   }}\n   \n   \n      // Ewe reproduction and lamb management //\n                               \n   private void joinEwes()\n   { \n      //Setting reproductive cycle + lamb management relative to joining date (as done in AusFarm)\n      // these dates are day-of-year. Equate with today.DayOfYear\n      \n     JoinDate = DateTime.Parse(JoinDate.ToString());        \n     join_median = JoinDate.AddDays(mating_offset-1); //in Lucy's code she divides this by 365         \n     birthsday = (join_median.AddDays(gestation - 1));  //in Lucy's code she divides this by 365 and then adds 1                                  \n\t castrate_day = JoinDate.AddDays(Join_Length+gestation-1); //in Lucy's code she divides this by 365 and then adds 1    \n     wean_day = join_median.AddDays(gestation + wean_age_days - 1);  //in Lucy's code she divides this by 365 and then adds 1             \n  \n  \n  //this is from Lucy's code. I don't this it's necessary.       \n   //   for (int g = 1; g <= stock.NoGroups; g++) \n     // {\n        // int animalTag = stock.tag_no[g - 1];             // stock tag details\n        // if (animalTag == EWES);                        // if animal = 1 (assigned to EWES)\n       //  {\n           // JoinType joining = new JoinType();\t\t//this is from Lucy's code: not sure what it is\n         //   joining.group = g;\n           // joining.mate_days = join_length;\n          //  joining.mate_to = mated_to;\n          //  stock.Join(joining);                        // stock mated_to = terminal sire, for join_length - both parameters\n         }  \n      }\n   }\n\n  \r\n",
          "Parameters": [
            {
              "Key": "PromoteEarly",
              "Value": "False"
            },
            {
              "Key": "JoinEarlyDate",
              "Value": ""
            },
            {
              "Key": "JoinFirstDate",
              "Value": ""
            },
            {
              "Key": "JoinLastDate",
              "Value": ""
            },
            {
              "Key": "Join_Length",
              "Value": "0"
            },
            {
              "Key": "wean_age_days",
              "Value": "0"
            },
            {
              "Key": "mated_to",
              "Value": ""
            },
            {
              "Key": "mating_offset",
              "Value": "0"
            },
            {
              "Key": "lambing_rate",
              "Value": ""
            },
            {
              "Key": "gestation",
              "Value": "0"
            },
            {
              "Key": "castrate",
              "Value": "False"
            },
            {
              "Key": "num_castrate",
              "Value": "0"
            },
            {
              "Key": "num_to_wean",
              "Value": "0"
            }
          ],
          "Name": "Join",
