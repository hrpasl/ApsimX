    {
      "$type": "Models.Memo, Models",
      "Text": "#Stock Model Example Simulations\n\n\nContributors:\n\n* Neville Herrman (CSIRO)\n* Dean Holzworth (CSIRO)\n* Di Mayberry (CSIRO)\n* Mark Liefferring (AgResearch\n* Val Snow (AgResearch)\n\nFunding Acknowledgements:\n\n* CSIRO ???? fund\n* AgResearch Strategic Science Investment Fund\n* APSIM Initiative Development Fund\n\n\nThis simulation file contains examples of how to use Stock is a variety of settings. Each simulation has a variety of Managers that are explained in this PDF and/or as in-text comments in the Manager scripts. The intention is that they can form starting points for new simulations and as such may not make much practical sense.\nIncluded are:\n\n*  Agistment grazing of a forage crop with supplements offered \n*  A simple rotation of stock around five paddocks\n*  Feedlot sheep tactically grazing a wheat crop\n\n\n",
      "Name": "Stock Model Examples",
      "ResourceName": null,
      "Children": [],
      "Enabled": true,
      "ReadOnly": false
    },
    {
      "$type": "Models.Core.Folder, Models",
      "ShowInDocs": false,
      "GraphsPerPage": 6,
      "Name": "Trial Scripts",
      "ResourceName": null,
      "Children": [
        {
          "$type": "Models.Manager, Models",
          "Code": "using Models.PMF.Interfaces;\nusing System.Diagnostics;\nusing Models.AgPasture;\nusing System.Linq;\nusing System.Collections.Generic;\nusing System.Collections;\nusing Models.Soils;\nusing Models.PMF;\nusing System.Xml.Serialization;\nusing APSIM.Shared.Utilities;\nusing Models.GrazPlan;\nusing Models.Utilities;\nusing Models.Functions;\nusing Models.Core;\nusing Models;\nusing System;\n\nnamespace Models\n{\n\n    [Serializable]\n    public class Script : Model\n    {\n        [Link] Clock clock;\n        [Link] Stock stock;\n        [Link] Supplement supplement;\n        [Link] List<Zone> paddocks;\n        [Link] ISummary summary;\n        [Link] Simulation farm;\n        [Link] List<IPlantDamage> forages = null;\n\n        private int CurrentGroupNum = 1;    // animal group number\n        private int CurrentLocationNum { get; set; }\n   \t  private IBooleanFunction expressionFunction;\n     \n             public enum BuyPolicyType\n        {\n            Date,\n            Other\n        }\n        \n                public enum StockEnterprise\n        {\n            /// <summary>\n            /// Wether\n            /// </summary>\n            entWether,\n            /// <summary>\n            /// Ewes and wethers\n            /// </summary>\n            entEweWether,\n            /// <summary>\n            /// Steers\n            /// </summary>\n            entSteer,\n            /// <summary>\n            /// Beef cow breeding\n            /// </summary>\n            entBeefCow,\n            /// <summary>\n            /// Trading lambs\n            /// </summary>\n            entLamb\n        }\n\n\n        [Description(\"Buy animals?\")]\n        public bool Buying { get; set; }\n        \n        [Description(\"Enterprise\")] \n        [Display(EnabledCallback = \"BuyingEnabled\")]\n        public StockEnterprise Enterprise { get; set; }\n        \n //       [Description (\"Animal Type\")]\n  //      public AnimalType Type {get; set;} \n        \n           [Description(\"Stock: genotype (e.g. Small Merino, Angus, Friesian):\")] \n        [Display(Values=\"GetGenotypes\")]\n        public string Genotype { get; set; } \n  \n        [Description(\"Whole-farm stocking rate (head/ha): \")] \n        public double StockingRate { get; set; } \n        \n        [Description(\"Condition Score\")]\n        public double CondScore {get; set; }\n        \n        [Description(\"Stock: sex (Female, Male, Castrate):\")] \n        public ReproductiveType Sex { get; set; }\n        \n        [Description(\"Stock: fertility status (0 if non-pregnant or days since conception):\")] \n        public int Pregnant { get; set; }\n\n        [Description(\"Stock: lactation status (0 if non-lactating or days since parturition):\")]\n        public int Lactating { get; set; }\n        \n        [Description(\"Stock: age (months):\")] \n        public double Age { get; set; }\n\n        [Description(\"Stock: weight (kg liveweight /head):\")] \n        public double Weight { get; set; }\n        \n        [Description(\"Number of animals to buy: \")] \n        public int NumStock { get; set; }\n        \n        [Description(\"Buying policy \")] \n        [Display(EnabledCallback = \"BuyingEnabled\")]\n        public BuyPolicyType BuyPolicy { get; set; }\n   \n          public bool BuyingEnabled { get { return Buying; } }\n          \n           public bool BuyingOtherEnabled\n        { \n            get\n            { \n                return Buying &&\n                (BuyPolicy == BuyPolicyType.Other);\n            } \n        }\n        \n        public bool BuyingDateEnabled\n        {\n        \tget\n        \t{\n        \t\treturn Buying &&\n        \t\t(BuyPolicy==BuyPolicyType.Date);\n        \t}\n        }\n             \n        [Separator(\"Buy on a date\")]\n        [Description(\"Date to buy animals (dd-mmm)\")] \n               [Display(EnabledCallback = \"BuyingDateEnabled\")]\n        public string BuyDate { get; set; }\n        \n        \n        \n        [Separator(\"Settings for flexible buying\")]\n        [Description(\"Expression for flexible buying criteria (e.g. AGPRyegrass.CoverTotal > 0.95)\")]\n       [Display(EnabledCallback = \"BuyingOtherEnabled\")]\n        public string FlexibleExpressionForBuying { get; set; }\n\n\n   //    public string[] GetAnimals()\n     //   {\n \t   // \tif (stock!= null)\n        //\t\treturn GrazType.AnimalType\n       //\treturn null;\n        //}\n\n        // Return a list of genotypes to the properties tab. filter by animal type\n        public string[] GetGenotypes()\n        {\n            if (stock != null)\n                return stock.Genotypes.Names.ToArray();\n            return null;\n        }\n        \n\n\t\t\n        [EventSubscribe(\"DoManagement\")]\n        private void OnDoManagement(object sender, EventArgs e)\n        {\n\n\t\t\tif (DateUtilities.WithinDates(BuyDate, clock.Today, BuyDate))\n        {\n\n            //Debugger.Break();\n\n            summary.WriteMessage(this, \"Initialising the paddock information\", MessageType.Diagnostic);\n\n            NumStock = (int)(Math.Round(StockingRate * farm.Area, 0));\n\n            BuyStock();\n            summary.WriteMessage(this, \"     Number of stock bought is \" + NumStock, MessageType.Diagnostic);\n            summary.WriteMessage(this, \"     The number of animals has been rounded to \" + NumStock + \" from \" + (StockingRate * farm.Area), MessageType.Diagnostic);\n            summary.WriteMessage(this, \"     The area of the whole farm is \" + farm.Area + \" ha\", MessageType.Diagnostic);\n\n        }\n        }\n\n        public void BuyStock()\n        {\n            CurrentGroupNum = stock.NoGroups + 1;\n            StockBuy purchase = new StockBuy();\n            purchase.Genotype = Genotype;\n            purchase.Number = NumStock;\n            purchase.Sex = Sex;\n            purchase.Age = Age;       // age in months\n            purchase.Weight = Weight;  // live weight in kg\n            purchase.UseTag = CurrentGroupNum + 1;\n            purchase.MatedTo = purchase.Genotype;\n            purchase.Pregnant = Pregnant;  // days pregnant, 0 = non pregnant, 1 = pregnant\n            purchase.Lactating = Lactating;  // 0 for dry, 1 for lactating\n\n            stock.Buy(purchase);\n        }\n\n\n    }\n}\n\n",
          "Parameters": [
            {
              "Key": "Buying",
              "Value": "False"
            },
            {
              "Key": "Enterprise",
              "Value": "entWether"
            },
            {
              "Key": "Genotype",
              "Value": "Angus"
            },
            {
              "Key": "StockingRate",
              "Value": "5"
            },
            {
              "Key": "CondScore",
              "Value": "0"
            },
            {
              "Key": "Sex",
              "Value": "Female"
            },
            {
              "Key": "Pregnant",
              "Value": "0"
            },
            {
              "Key": "Lactating",
              "Value": "0"
            },
            {
              "Key": "Age",
              "Value": "12"
            },
            {
              "Key": "Weight",
              "Value": "100"
            },
            {
              "Key": "NumStock",
              "Value": "0"
            },
            {
              "Key": "BuyPolicy",
              "Value": "Date"
            },
            {
              "Key": "BuyDate",
              "Value": ""
            },
            {
              "Key": "FlexibleExpressionForBuying",
              "Value": ""
            }
          ],
          "Name": "Buy",
          "ResourceName": null,
          "Children": [],
          "Enabled": true,
          "ReadOnly": false
        },
        {
          "$type": "Models.Manager, Models",
          "Code": "/*-------------------------------------------------------------------------------------\nSheep grazing wheat when conditions are suitable, and in feedlot the rest of the time.\n---------------------------------------------------------------------------------------\n\nIn this script animals are bought and sold within a specified date window.\nThey are fed supplement in a feedlot at a set rate, but graze a wheat crop when a criteria is met.\nAnimals are moved from the wheat crop and back to feedlot when a second criteria is met.\n\nBased on Sprague SJ, Kirkegaard JA, Dove H, Graham JM, McDonald SE, Kelman WM (2015) Integrating dual-purpose wheat and canola into high-rainfall livestock systems in south-eastern Australia. 1. Crop forage and grain yield. Crop and Pasture Science 66(4), 365-376. \n\nActivities in this manager:\n1. Buy animals at start of year & put in feedlot\n2. Move animals from feedlot to crop when ready to graze\n3. Move animals from crop to feedlot \n4. Shear all animals on specified date\n5. Sell all animals at end of year\n\nNOTES\n1. When the animals are in the feedlot and an animal dies during the day, the supplement has already been fed into the feedlot\n   based on the number of animals in the feedlot at the start of the day. This means the remaining animals have access to slightly\n   more supplement and causes a spike in supp intake graph\n2. When sheep are culled for age + purchased to maintain stocking rate, several groups of sheep are created.\n   This causes irregular amounts of supplement to be fed.\n--------------------------------------------------------------------------------------*/\n\n\nusing System.Linq;\nusing System;\nusing System.Collections.Generic;\nusing Models.Core;\nusing Models.PMF;\nusing Models.Functions;\nusing Models.Soils;\nusing Models.Utilities;\nusing Models.GrazPlan;\nusing APSIM.Shared.Utilities;\nusing System.Diagnostics;\n\nnamespace Models\n{\n    [Serializable]\n    [Description(\n        \"<p><b>Animals grazing a crop when conditions are suitable, and in feedlot the rest of the time.</b></p>\" +\n        \"In this script animals are bought and sold within a specified date window. \" +\n        \"They are fed supplement in a feedlot at a set rate, but graze a wheat crop when a criteria is met. \" +\n        \"Animals are moved from the wheat crop and back to feedlot when a second criteria is met.\")]    \n    public class Script : Model\n    {\n        [Link] Clock clock;\n        [Link] Stock Animals;\n        [Link] Supplement Feed;\n        [Link] Summary Summary;\n        [Link] IPlant plant;\n        [Link] Soil Soil;\n        [Link] Zone Paddock;\n        [Link] ScriptCompiler compiler;\n\n        private IBooleanFunction expressionFunction;\n\n        public enum SellPolicyType\n        {\n            Date,\n            CulledForAge,\n            CulledForWeight,\n            SellYoung,\n            Other\n        }\n\n  \n        ////////////////////////////////////////////////////////\n        [Separator(\"Selling of animals\")]\n\n        [Description(\"Selling animals?\")] \n        public bool Selling { get; set; }\n\n        [Description(\"First date to consider selling animals (dd-mmm)\")] \n        public string SaleFirstDate { get; set; }\n\n        [Description(\"Last date to consider selling animals (dd-mmm)\")] \n        public string SaleLastDate { get; set; }\n\n        [Description(\"Selling policy \")] \n        [Display(EnabledCallback = \"SellingEnabled\")]\n        public SellPolicyType SellPolicy { get; set; }\n \n        [Description(\"Percentage of animals to sell (%)\")] \n        [Display(EnabledCallback = \"SellingEnabled\")]\n        public double SalePercentAnimals { get; set; }\n\n        [Description(\"Age at which to sell (months): \")] \n        [Display(EnabledCallback = \"SellingAgeEnabled\")]\n        public int SaleAge { get; set; }\n\n        [Description(\"Weight at which to sell (kg): \")] \n        [Display(EnabledCallback = \"SellingWeightEnabled\")]\n        public double SaleWeight { get; set; }\n\n       [Separator(\"Settings for flexible selling\")]\n        [Description(\"Expression for flexible selling criteria (e.g. AGPRyegrass.CoverTotal > 0.95)\")]\n        [Display(EnabledCallback = \"SellingOtherEnabled\")]\n        public string FlexibleExpressionForBuying { get; set; }\n\n\n        ////////////////////////////////////////////////////////////////////////////\n        // Callback properties to control disabling of properties.\n        ////////////////////////////////////////////////////////////////////////////\n\n        public bool SellingEnabled { get { return Selling; } }\n\n        public bool SellingAgeEnabled\n        { \n            get\n            { \n                return Selling &&\n                (SellPolicy == SellPolicyType.CulledForAge);\n            } \n        }\n\n        public bool SellingWeightEnabled\n        { \n            get\n            { \n                return Selling &&\n                (SellPolicy == SellPolicyType.CulledForWeight);\n            } \n        }\n        \n        public bool SellingOtherEnabled\n        { \n            get\n            { \n                return Selling &&\n                (SellPolicy == SellPolicyType.Other);\n            } \n        }\n        \n\n        ////////////////////////////////////////////////////////////////////////////\n        // Outputs\n        ////////////////////////////////////////////////////////////////////////////\n        // <summary>Number of animals sold.</summary>\n        public int NumberSold { get; set; }\n\n        // <summary>Description of something that has happened.</summary>\n        public string EventName { get; set; }\n\n        // <summary>Return a list of genotypes to the properties tab.</summary>\n        public string[] GetGenotypes()\n        {\n            if (Animals != null)\n                return Animals.Genotypes.Names.ToArray();\n            return null;\n        }\n\n        public string CurrentLocation { get; set; }  // location of the sheep\n  \n\n\n\n        // ============================================================\n        // Management that happens every day.\n        // ============================================================\n        [EventSubscribe(\"DoManagement\")]\n        private void OnDoManagement(object sender, EventArgs e)\n        {\n            EventName = string.Empty;\n\n            // Sell animals\n            // Sell animals\n            if (SellingEnabled && DateUtilities.WithinDates(SaleFirstDate, clock.Today, SaleLastDate))\n                {\n                    IEnumerable<AnimalGroup> AnimalsToSell = null;\n                    if (SellPolicy == SellPolicyType.CulledForAge)\n                      {  // split older animals into a new group\n                        AnimalsToSell = Animals.SplitByAge(Convert.ToInt32(SaleAge * 30)); // months to days\n                        }\n                    else if (SellPolicy == SellPolicyType.CulledForWeight)\n                        {// split heavier animals into a new group\n                        AnimalsToSell = Animals.SplitByWeight(SaleWeight);\n                        }\n                    else if (SellPolicy == SellPolicyType.SellYoung)\n                        {// split young (offspring) into new groups\n                        AnimalsToSell = Animals.SplitByYoung();\n                        }\n                      if (AnimalsToSell != null)\n                    {\n                        var numberSellableAnimals = AnimalsToSell.Sum(g => g.NoAnimals);\n                        var numberAnimalsToSell = Convert.ToInt32(numberSellableAnimals * SalePercentAnimals / 100.0);\n                        if (numberAnimalsToSell > 0)\n                            Animals.Sell(numberAnimalsToSell, AnimalsToSell);\n                            EventName = numberAnimalsToSell + \" animals sold\";\n                    }\n\n                    }                                 \n                }\n            }\n }\n \n",
          "Parameters": [
            {
              "Key": "Selling",
              "Value": "True"
            },
            {
              "Key": "SaleFirstDate",
              "Value": ""
            },
            {
              "Key": "SaleLastDate",
              "Value": ""
            },
            {
              "Key": "SellPolicy",
              "Value": "SellYoung"
            },
            {
              "Key": "SalePercentAnimals",
              "Value": "0"
            },
            {
              "Key": "SaleAge",
              "Value": "0"
            },
            {
              "Key": "SaleWeight",
              "Value": "0"
            },
            {
              "Key": "FlexibleExpressionForBuying",
              "Value": ""
            }
          ],
          "Name": "Sell",
          "ResourceName": null,
          "Children": [],
          "Enabled": true,
          "ReadOnly": false
        },
        {
          "$type": "Models.Manager, Models",
          "Code": "using System.Linq;\nusing System;\nusing System.Collections.Generic;\nusing Models.Core;\nusing Models.PMF;\nusing Models.Functions;\nusing Models.Soils;\nusing Models.Utilities;\nusing Models.GrazPlan;\nusing APSIM.Shared.Utilities;\nusing System.Diagnostics;\n\nnamespace Models\n{\n    [Serializable]\n    [Description(\n        \"<p><b>Animals grazing a crop when conditions are suitable, and in feedlot the rest of the time.</b></p>\" +\n        \"In this script animals are bought and sold within a specified date window. \" +\n        \"They are fed supplement in a feedlot at a set rate, but graze a wheat crop when a criteria is met. \" +\n        \"Animals are moved from the wheat crop and back to feedlot when a second criteria is met.\")]    \n    public class Script : Model\n    {\n        [Link] Clock clock;\n        [Link] Stock Animals;\n        [Link] Supplement Feed;\n        [Link] Summary Summary;\n        [Link] IPlant plant;\n        [Link] Soil Soil;\n        [Link] Zone Paddock;\n        [Link] ScriptCompiler compiler;\n\n\n        [Description(\"Date to shear animals (dd-mmm)\")] \n        public string ShearDate { get; set; }\n        \n         // <summary>Description of something that has happened.</summary>\n        public string EventName { get; set; }\n\n        \n            // Shear all animals on specified date\n        [EventSubscribe(\"DoManagement\")]\n        private void OnDoManagement(object sender, EventArgs e)\n        {\n                    EventName = string.Empty;\n                    \n            if (DateUtilities.DatesEqual(ShearDate, clock.Today))\n            {\n                Animals.Shear(shearAdults: true, shearYoung: true);\n                EventName = \"Animals shorn\";\n            }\n    }\n }\n }",
          "Parameters": [
            {
              "Key": "ShearDate",
              "Value": ""
            }
          ],
          "Name": "Shear",
          "ResourceName": null,
          "Children": [],
          "Enabled": true,
          "ReadOnly": false
        },
        {
          "$type": "Models.Manager, Models",
          "Code": "using System.Diagnostics;\nusing Models.AgPasture;\nusing System.Collections.Generic;\nusing System.Collections;\nusing Models.Soils;\nusing Models.PMF;\nusing System.Xml.Serialization;\nusing APSIM.Shared.Utilities;\nusing Models.GrazPlan;\nusing Models.Utilities;\nusing Models.Core;\nusing System;\nusing System.Linq;\nusing Models.ForageDigestibility;\nusing Models.Management;\n\nnamespace Models\n{\n\n    [Serializable]\n    public class Script : Model\n    {\n        [Link] Clock clock;\n        [Link] Stock stock;\n        [Link] Supplement supplement;\n        [Link] Plant crop;\n        [Link] Zone[] Paddocks;\n        [Link] ISummary summary = null;\n        [Link] Simulation Farm;\n        [Link] Forages forages = null;\n\n        //List<AgPasture.PastureSpecies> Pasture = new List<AgPasture.PastureSpecies>();\n  \n        public class PaddockInfo\n        {\n            public Zone Field { get; }\n            public IEnumerable<ModelWithDigestibleBiomass> Forages { get; }\n            public double HarvestableBiomass\n            {\n                get\n                {\n                    double total = 0;\n                    foreach (var model in Forages)\n                        foreach (var material in model.Material)\n                            total += material.Consumable.Wt * 10; // g/m2 to kg/ha\n                    return total;            \n                }\n            }\n             public PaddockInfo(IEnumerable<ModelWithDigestibleBiomass> forages, Zone field)\n            {\n                Field = field;\n                Forages = forages;\n            }\n            }\n\n        public enum RotationMethodType\n        {\n            FixedTimePasture,\n            BestPasture,\n            Crop\n                    }\n                    \n       public enum CropGrazingMethodType\n        {\n            Date,\n            Stage\n                    }\n                    \n                    \n        [Description(\"Do verbose reporting from this script (tick for yes): \")] \n        public bool DoVerbose { get; set; }\n\n        [Separator(\"Whole farm and initial location\")]\n        \n         [Description(\"Set a Rotation for animals: \")]        \n       public bool Rotating { get; set; }\n       \n       //need something to specify which animals\n\n        [Description(\"Initial location of the animasls (paddock name):\")] \n        [Display(Type=DisplayType.Model, ModelType=typeof(Zone))]\n        public IModel InitialLocation { get; set; }\n\n       [Description(\"Whole-farm stocking rate (head/ha): \")]\n        public double StockingRate { get; set; } \n\n        [Separator(\"Settings for the rotation\")]    \n            \n        [Description(\"Rotation Method \")] \n        [Display(EnabledCallback = \"RotatingEnabled\")]\n        public RotationMethodType RotationMethod { get; set; } \n\n        [Description(\"Target rotation length (days/paddock): \")] \n         [Display(EnabledCallback = \"FixedTimePastureEnabled\")]\n        public int TargetRotationLength { get; set; }\n\n        [Description(\"Post-grazing residual to trigger pasture conservation (kgDM/ha): \")] \n        public double PostGrazingResidual { get; set; }\n\n        [Description(\"Post-cutting residual (kgDM/ha): \")] \n        public double PostCuttingResidual { get; set; }\n\n        [Description(\"Harvest excess herbage above residual when cows leave the paddock?: \")] \n        public bool HarvestExcessHerbage { get; set; }\n        \n        [Description(\"Maximum pasture mass (kgDM/ha) (needs to be under this amount before looking for best pasture):\")]\n        [Display(EnabledCallback = \"BestPastureEnabled\")]\n        public double finish_level_pasture {get;set;}\n        \n        [Description(\"Crop Grazing Window \")] \n        [Display(EnabledCallback = \"CropEnabled\")]\n        public CropGrazingMethodType CropGrazing { get; set; } \n        \n        [Description(\"First date to consider moving animals:\")] \n        [Display(EnabledCallback = \"CropEnabled\")]\n        public string StartDate { get; set; }\n\n        [Description(\"Last date to consider moving animals:\")]\n        [Display(EnabledCallback = \"CropEnabled\")]\n        public string EndDate { get; set; }\n        \n        [Description(\"First stage to consider moving animals (if not date):\")] \n       [Display(EnabledCallback = \"CropEnabled\")]\n        public string StartStage { get; set; }\n\n        [Description(\"Last stage to consider moving animals (if not date):\")]\n        [Display(EnabledCallback = \"CropEnabled\")] //would like this to be just if stage is the type\n        public string EndStage { get; set; }\n\n        [Separator(\"Settings for supplementary feeding\")]\n        \n        [Description(\"DM trigger for Supplementing\")]\n        public double dosupplement { get; set; }\n  \n        [Description(\"Name of zone representing the feedlot\")]\n        [Display(Type=DisplayType.Model, ModelType=typeof(Zone))]\n        public IModel FeedlotZone { get; set; }\n\n        [Description(\"The amount of supplement to feed each animal each day (kg DM /head /day)\")]\n        public double SupplementAmount { get; set; }\n\n        [Description(\"The type of supplement to feed the animals\")]\n        public string SupplementType { get; set; }\n\n        [Description(\"Maximum supplement store - top up the store to this value when buying (kg DM)\")]\n        public double SupplementMaxAmount { get; set; }\n\n        [Description(\"Criteria upon which to replenish the supplement store - ReplenishOnDate or ReplenishOnMinimum\")]\n        public string SupplementReplenishCriteriaType { get; set; }\n\n        [Description(\"If 'ReplenishOnMinimum' then give the amount to trigger a buy supplement event (kg DM)\")]\n        public double SupplementMinAmount { get; set; }\n\n        [Description(\"If 'ReplenishOnDate' then give the date to trigger a buy supplement event (dd-mmm)\")]\n        public string SupplementReplenishDate { get; set; }\n        \n        [Separator(\"FeedWedge\")]\n        \n         [Description(\"Do you want to output Average Pasture Cover (APC)? \")]        \n       public bool FeedWedge { get; set; }\n       \n\n        public int NumStock { get; set; } // number of animals on the whole farm\n        public int NumStockinPaddock {get; set;} // count number of each animal group in each paddock\n        public string TypeStockinPaddock {get;set;} // group in paddock\n        \n        public string pastLocationName { get; set; }  // \n        public string newLocationName { get; set; }  // \n        public string best_paddock {get; set;}\n        \n        public int CurrentLocationNum { get; set; }  // name of the paddock that the cows are currently in\n        public string CurrentLocationName { get; set; }\n        public int NumPaddocks { get; set; }\n        public double SilageHarvested { get; set; } // RAmount of silage harvested (kg DM /ha)\n        \n\n        private int group_count; // how many groups are there in the simulation\n        private int g = 1;      // index to the groups of animals\n\n        //private int DaysPerPaddock;\n        private int DaysInThisPaddock;\n        private bool MoveToday = false;\n        private bool Initialised = false;\n        public double BiomassInCurrentPaddock;\n        public double HarvestableBiomass { get; set; }\n        public double HarvestableBiomassYesterday { get; set; }\n\n        public event BiomassRemovedDelegate BiomassRemoved;\n        public List<PaddockInfo> listOfPaddockInfo { get; set; }\n        \n        public double currentPaddockDM {get; set;}\n        public double dm_max {get;set;}\n\n        public double TillageDate {get;set;}\n        private DateTime CheckDate;\n        private string EventName;\n       \n        ////////////////////////////////////////////////////////////////////////////\n        // Callback properties to control disabling of properties.\n        ////////////////////////////////////////////////////////////////////////////\n\n        public bool RotatingEnabled { get { return Rotating; } }\n\n        public bool FixedTimePastureEnabled\n        { \n            get\n            { \n                return Rotating &&\n                (RotationMethod == RotationMethodType.FixedTimePasture);\n            } \n        }\n        public bool BestPastureEnabled\n        { \n            get\n            { \n                return Rotating &&\n                (RotationMethod == RotationMethodType.BestPasture);\n            } \n        }\n         public bool CropEnabled\n        { \n            get\n            { \n                return Rotating &&\n                (RotationMethod == RotationMethodType.Crop) &&\n                ((CropGrazing == CropGrazingMethodType.Date)||(CropGrazing == CropGrazingMethodType.Stage));\n            }           \n        }\n        \n        \n        \n      ////////////////////////////////////////////////////////////////////////////\n        // Initialise\n        //////////////////////////////////////////////////////////////////////////// \n        \n                private void Initialise()\n        {\n            summary.WriteMessage(this, \"Initialising the paddock information\", MessageType.Diagnostic);\n            listOfPaddockInfo = new List<PaddockInfo>();\n            CurrentLocationName = InitialLocation.Name;\n\n            GetPaddockInfo();\n            //HarvestableBiomass = Farm.\n\n            NumStock = (int)(Math.Round(StockingRate * Farm.Area, 0));\n\n            //SetInitialCowStuff();\n\n            if (NumStock > 0)\n                stock.Move(CurrentLocationName);\n\n            summary.WriteMessage(this, \"     The number of animals has been rounded to \" + NumStock + \" from \" + (StockingRate * Farm.Area), MessageType.Diagnostic);\n            summary.WriteMessage(this, \"     The animals will begin in \" + CurrentLocationName + \" which is paddock number \" + CurrentLocationNum + \" in the simulation\", MessageType.Diagnostic);\n            summary.WriteMessage(this, \"     The area of the whole farm is \" + Farm.Area + \" ha\", MessageType.Diagnostic);\n\n            DaysInThisPaddock = -1;\n            SilageHarvested = 0.0;\n            Initialised = true;\n        }\n        \n     \n\n        [EventSubscribe(\"DoManagement\")]\n        private void OnDoManagement(object sender, EventArgs e)\n        {\n            if (!Initialised)\n                Initialise();\n            SilageHarvested = 0.0;\n\n            MoveToday = false;\n            \n            // Calculate forage mass in the paddock\n            HarvestableBiomass = 0.0;\n            foreach  (var forage in forages.ModelsWithDigestibleBiomass.Where(f => f.Zone.Name == CurrentLocationName))\n                        HarvestableBiomass += forage.Material.Sum(f => f.Total.Wt);\n            \n            HarvestableBiomass *= 10;  // Convert to kg/ha\n           \n            \n      ////////////////////////////////////////////////////////////////////////////\n        // Script for FixedTimePasture\n        ////////////////////////////////////////////////////////////////////////////    \n        \n        \n            DaysInThisPaddock += 1;\n            if (RotationMethod == RotationMethodType.FixedTimePasture && DaysInThisPaddock >= TargetRotationLength)\n            {\n                MoveToday = true;\n\n                pastLocationName = CurrentLocationName;\n                if (CurrentLocationNum < NumPaddocks - 1)\n                {\n                    CurrentLocationNum += 1;\n                    newLocationName = listOfPaddockInfo[CurrentLocationNum].Field.Name;\n                }\n                else\n                {\n                    CurrentLocationNum = 0;\n                    newLocationName = listOfPaddockInfo[CurrentLocationNum].Field.Name;\n                }\n                CurrentLocationName = listOfPaddockInfo[CurrentLocationNum].Field.Name;\n           \n\n                if (HarvestExcessHerbage)\n                {\n                    foreach (Zone paddock in Paddocks)\n                    {\n                        if (paddock.Name == pastLocationName)\n                        {\n                            double pastPaddockBiomass = 0.0;\n                            foreach (var forage in forages.ModelsWithDigestibleBiomass.Where(f => f.Zone.Name == pastLocationName))\n                                pastPaddockBiomass += forage.Material.Sum(f => f.Total.Wt) * 10;   // kg/ha \n\n                            if (pastPaddockBiomass > PostGrazingResidual)  \n                            {\n                                foreach (var forage in forages.ModelsWithDigestibleBiomass.Where(f => f.Zone.Name == pastLocationName))\n                                {\n                                    var aboveGroundWt = forage.Material.Sum(f => f.Total.Wt) * 10;  // kg/ha \n                                    var amountToRemove = aboveGroundWt / pastPaddockBiomass * PostCuttingResidual;\n                                    forage.RemoveBiomass(type: \"SetResidueAmount\", amount: amountToRemove / 10);\n                                    SilageHarvested += amountToRemove;\n                                }\n\n                            }\n                        }\n                    }\n                }\n            }\n            \n            \n        ////////////////////////////////////////////////////////////////////////////\n        // Script for BestPasture\n        ////////////////////////////////////////////////////////////////////////////        \n\n if (RotationMethod == RotationMethodType.BestPasture)\n            {\n                MoveToday = true;\n\n                if ((currentPaddockDM < dm_max) && (dm_max > finish_level_pasture)) //if a better paddock is found that is above the finish level\n            {\n                  {\n   /// <summary>\n   /// Move animals around pasture paddocks based on available biomass\n   /// They will only be moved by this function if they are on a pasture paddock already.              \n   /// </summary>\n   {\n  \t\t CheckDate = DateTime.Parse(clock.Today.ToString());\n         CheckDate= CheckDate.AddDays(2);\n      // only draft if there are stock and check every 2 days\n      if ((NumStock > 0) && (clock.Today==CheckDate))  // checks pasture threshold every second day for the dm threshold.\n      {   \n      \n         \n         double dm_max = 0.0;\n         \n         double currentPaddockDM = HarvestableBiomass;  // kg/ha   //get dm in stocked paddock\n         if (currentPaddockDM < finish_level_pasture) //if current paddock for stock < biomass threshold (kg/ha)  \n         { \n                     stock.Move(best_paddock);//need to link best_paddock to script at bottom\n                     DaysInThisPaddock = 0;\n          if (DoVerbose)\n                    summary.WriteMessage(this, \"moving Stock to \" + listOfPaddockInfo[CurrentLocationNum].Field.Name, MessageType.Diagnostic);\n                  }\n               }\n            }\n\n         }}}\n                            \n                      \n                        \n        ////////////////////////////////////////////////////////////////////////////\n        // Script for Crop\n        ////////////////////////////////////////////////////////////////////////////  \n        \n//same as fixed time above but with options for when to put on and off (DM, stage, expression) and then have an additional rule to move stock if there are any operations\n            if (RotationMethod == RotationMethodType.Crop && crop.IsAlive)\n            {\n            double stage = (double)crop.FindByPath(\"Phenology.Stage\").Value;\n        \t\n \n            \tbool MoveToday = false;\n            \tif (CropGrazing == CropGrazingMethodType.Date && (DateUtilities.WithinDates(StartDate, clock.Today, EndDate)))\n            \t\tMoveToday = true;\n            \n             \t//else if (CropGrazing == CropGrazingMethodType.Stage && stage >= StartStage && stage<EndStage)\n             \t\t//MoveToday=true;\n             \t\t\n             \n             \telse if (DateUtilities.WithinDates(crop.SowingDate,clock.Today,crop.SowingDate))\n             \t\tMoveToday = true;\n             \t\t\n             \telse if (DateUtilities.WithinDates(TillageDate.ToString(),clock.Today,TillageDate.ToString()))  //I have a strong feeling this is not going to work\n             \t\tMoveToday = true;\n\n                pastLocationName = CurrentLocationName;\n                if (CurrentLocationNum < NumPaddocks - 1)\n                {\n                    CurrentLocationNum += 1;\n                    newLocationName = listOfPaddockInfo[CurrentLocationNum].Field.Name;\n                }\n                else\n                {\n                    CurrentLocationNum = 0;\n                    newLocationName = listOfPaddockInfo[CurrentLocationNum].Field.Name;\n                }\n                CurrentLocationName = listOfPaddockInfo[CurrentLocationNum].Field.Name;\n\t\t\t\t}\n\n\n        ////////////////////////////////////////////////////////////////////////////\n        // Script for Supplement--not sure how to manage the supplement: do you need a trigger (dm on paddocks, overall grazing window, condition score of animals?) to put on supplement?\n        ////////////////////////////////////////////////////////////////////////////  \n//Supplement\n\n        {\n\n\t\t\tif (dm_max<dosupplement)\n\t\t\tstock.Move(FeedlotZone);  //not sure what the feedlot is: other option is to have a paddock called \"feedlot\" so it is stock.Move(\"feedlot\")\n            CurrentLocationName = \"Feedlot\";\n            EventName = \"Animals moved to feedlot\";\n\t\t\t\n\t\t\t\n\t\t\t\n\t\t\t\n\t\t\t\t\n\t\t\t\n            // Determine how many animals are in feedlot.\n            var animalGroupsInFeedlot = stock.AnimalGroups.Where(group => group.PaddOccupied.Name == FeedlotZone.Name);\n            var totalNumAnimalsInFeedlot = animalGroupsInFeedlot.Sum(group => group.NoAnimals);\n\n            // If there are animals in feedlot then feed them.\n            if (totalNumAnimalsInFeedlot > 0)\n                supplement.Feed(SupplementType, SupplementAmount * totalNumAnimalsInFeedlot, FeedlotZone.Name);     \n\n            // Restock the supplement store if amount falls below SupplementMinAmount kg DM\n            if (SupplementReplenishCriteriaType == \"ReplenishOnDate\" && DateUtilities.DatesAreEqual(SupplementReplenishDate, clock.Today))\n            \tsupplement.Buy(SupplementMaxAmount - supplement.Stores[1].Stored, SupplementType);\n            if (SupplementReplenishCriteriaType == \"ReplenishOnMinimum\" && supplement.Stores[1].Stored < SupplementMinAmount)\n              \tsupplement.Buy(SupplementMaxAmount - supplement.Stores[1].Stored, SupplementType);\n        }}\n    \n\n\n        ////////////////////////////////////////////////////////////////////////////\n        // Script for FeedWedge\n        ////////////////////////////////////////////////////////////////////////////  \n//This is for efficiency--generate output and allow for a choice to remove paddock(s) from the rotation\n//Daily graph with pasture APC (average pasture cover)\n//Daily graph of food source\n\n        ////////////////////////////////////////////////////////////////////////////\n        // Script for Visual Checks Output \n        ////////////////////////////////////////////////////////////////////////////  \n//Daily pictorial of animal location\n \n            \n            \n            \n            \n\t\t\t\t\tpublic void GetPaddockInfo()\n        {\n            NumPaddocks = 0;\n            CurrentLocationNum = 0;\n\n            foreach (Zone paddock in Paddocks)\n            {\n                NumPaddocks += 1;\n\n                var paddockInfo = new PaddockInfo(forages.ModelsWithDigestibleBiomass.Where(f => f.Zone == paddock), paddock);\n                listOfPaddockInfo.Add(paddockInfo);\n\n                summary.WriteMessage(this, \"     Paddock \" + NumPaddocks + \" is called \" + paddock.Name + \", has an area of \" + paddock.Area + \" ha and an initial harvestable biomass of \" + paddockInfo.HarvestableBiomass + \" kg DM / ha\", MessageType.Diagnostic);\n\n            }\n            \n            CurrentLocationNum = listOfPaddockInfo.FindIndex(p => p.Field.Name == CurrentLocationName);\n            if (CurrentLocationNum == -1)\n                throw new Exception($\"Cannot find paddock {CurrentLocationName}\");\n\n        }\n        \n          public double bestPaddockDM()\n   {\n      double dm_max = 0;\n      //(find paddock with most pasture)\n      for (int p = 1; p <= 8; p++) //for each pasture paddock\n      {\n         string otherPaddock = \"PasturePaddock\" + p.ToString(); // Going through each pasture paddock and allocating 1-6\n         double other_dm = HarvestableBiomass; //get dm amount\n         if (other_dm > dm_max) \n         {\n            dm_max = other_dm;\n         }\n      }\n      return dm_max;\n   }\n        \n        \n       \n        }}\n          \n            ",
          "Parameters": [
